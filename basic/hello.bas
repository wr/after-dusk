10 D$ = CHR$(4):S = 0
20 ONERR GOTO 60
30 PRINT D$;"OPEN SEED": PRINT D$;"READ SEED": INPUT S
50 PRINT D$;"CLOSE"
60 POKE 216,0
70 S = S + 1: IF S > 65535 THEN S = 1
80 ONERR GOTO 100
90 PRINT D$;"OPEN SEED": PRINT D$;"WRITE SEED": PRINT S: PRINT D$;"CLOSE"
100 POKE 216,0
110 POKE 768,S - INT (S / 256) * 256: POKE 769, INT (S / 256)
115 PRINT D$;"BLOAD FX"
120 PRINT D$;"BRUN AFTERDUSK"
